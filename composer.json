{
  "name": "esquare/theme-wp",
  "authors": [
    {
      "name": "jfsenechal",
      "email": "jfsenechal@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-intl": "*",
    "ext-pdo": "*",
    "nesbot/carbon": "^3.11.4",
    "symfony/cache": "^8.0",
    "symfony/console": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/error-handler": "8.0.*",
    "symfony/http-client": "^8.0",
    "symfony/http-foundation": "^8.0",
    "symfony/mailer": "^8.0",
    "twig/intl-extra": "^v3.8.0",
    "twig/string-extra": "^v3.8.0",
    "twig/twig": "^v3.8.0"
  },
  "autoload": {
    "psr-4": {
      "Esquare\\Theme\\": "wp-content/themes/esquare/src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "version": "1.0.0",
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "8.0.*",
      "docker": false
    }
  }
}
