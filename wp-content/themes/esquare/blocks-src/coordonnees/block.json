{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "esquare/coordonnees",
    "version": "1.0.0",
    "title": "Coordonnées",
    "category": "theme",
    "icon": "location",
    "description": "Section avec titre et cartes de coordonnées (adresse, téléphone, e-mail…) : icône, intitulé, valeur (lien en option), note et lien secondaire.",
    "textdomain": "esquare",
    "supports": {
        "html": false,
        "align": ["full"],
        "anchor": true
    },
    "attributes": {
        "align": { "type": "string", "default": "full" },
        "anchor": { "type": "string", "default": "coordonnees" },
        "eyebrow": { "type": "string", "default": "Nous trouver" },
        "title": { "type": "string", "default": "" },
        "intro": { "type": "string", "default": "" },
        "cards": {
            "type": "array",
            "default": [
                { "icon": "adresse", "label": "Adresse", "value": "Rue Victor Libert 36 J<br>6900 Marche-en-Famenne", "url": "", "note": "", "linkText": "", "linkUrl": "" },
                { "icon": "telephone", "label": "Téléphone", "value": "084 / 32.70.54", "url": "", "note": "", "linkText": "", "linkUrl": "" },
                { "icon": "email", "label": "E-mail", "value": "info@esquare.be", "url": "", "note": "", "linkText": "", "linkUrl": "" }
            ]
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "render": "file:./render.php"
}
