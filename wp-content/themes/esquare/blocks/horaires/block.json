{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "esquare/horaires",
  "version": "1.0.0",
  "title": "Horaires",
  "category": "theme",
  "icon": "clock",
  "description": "Encadré jaune des horaires : titre, introduction, créneaux et note.",
  "textdomain": "esquare",
  "supports": {
    "html": false,
    "align": [
      "full"
    ],
    "anchor": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "default": "horaires"
    },
    "eyebrow": {
      "type": "string",
      "default": "Horaires"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "slots": {
      "type": "array",
      "default": [
        {
          "label": "Lundi au jeudi",
          "from": "09:00",
          "to": "17:00"
        },
        {
          "label": "Vendredi",
          "from": "09:00",
          "to": "15:00"
        }
      ]
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "title": "Toujours <em>sur</em> rendez-vous",
      "intro": "Le rendez-vous garantit qu’un animateur est là pour vous."
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}