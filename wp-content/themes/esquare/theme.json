{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "760px",
            "wideSize": "1240px"
        },
        "color": {
            "background": true,
            "text": true,
            "link": true,
            "custom": true,
            "customGradient": true,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                { "slug": "navy",        "name": "Navy",        "color": "#0E1F33" },
                { "slug": "navy-soft",   "name": "Navy Soft",   "color": "#1A2D4A" },
                { "slug": "navy-deep",   "name": "Navy Deep",   "color": "#081523" },
                { "slug": "yellow",      "name": "Yellow",      "color": "#F2B33D" },
                { "slug": "yellow-soft", "name": "Yellow Soft", "color": "#FDE3A6" },
                { "slug": "white",       "name": "White",       "color": "#FCFAF5" },
                { "slug": "cream",       "name": "Cream",       "color": "#FAF8F3" },
                { "slug": "stone-warm",  "name": "Stone Warm",  "color": "#F1ECE3" },
                { "slug": "slate",       "name": "Slate",       "color": "#4A5568" },
                { "slug": "slate-soft",  "name": "Slate Soft",  "color": "#E2E8F0" },
                { "slug": "ink",         "name": "Ink",         "color": "#0B1422" }
            ],
            "gradients": [
                { "slug": "navy-deep",   "name": "Navy Deep",   "gradient": "linear-gradient(135deg, #0E1F33 0%, #1A2D4A 100%)" },
                { "slug": "yellow-warm", "name": "Yellow Warm", "gradient": "linear-gradient(135deg, #F2B33D 0%, #FDE3A6 100%)" },
                { "slug": "navy-fade",   "name": "Navy Fade",   "gradient": "linear-gradient(180deg, rgba(14,31,51,0) 0%, rgba(14,31,51,0.75) 100%)" }
            ]
        },
        "typography": {
            "fluid": true,
            "defaultFontSizes": false,
            "fontFamilies": [
                {
                    "slug": "sans",
                    "name": "Sans",
                    "fontFamily": "Figtree, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
                },
                {
                    "slug": "display",
                    "name": "Display",
                    "fontFamily": "'Instrument Serif', Georgia, 'Times New Roman', serif"
                },
                {
                    "slug": "mono",
                    "name": "Mono",
                    "fontFamily": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
                }
            ],
            "fontSizes": [
                { "slug": "xs",       "name": "XS",       "size": "0.8125rem" },
                { "slug": "small",    "name": "Small",    "size": "0.9375rem" },
                { "slug": "medium",   "name": "Medium",   "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
                { "slug": "large",    "name": "Large",    "size": "1.25rem",   "fluid": { "min": "1.125rem", "max": "1.25rem" } },
                { "slug": "x-large",  "name": "X Large",  "size": "1.625rem",  "fluid": { "min": "1.375rem", "max": "1.625rem" } },
                { "slug": "xx-large", "name": "XX Large", "size": "2.5rem",    "fluid": { "min": "1.875rem", "max": "2.5rem" } },
                { "slug": "display",  "name": "Display",  "size": "4rem",      "fluid": { "min": "2.5rem",  "max": "4rem" } }
            ]
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "rem", "em", "%", "vh", "vw"],
            "spacingScale": { "steps": 0 },
            "spacingSizes": [
                { "slug": "10", "name": "1 (8px)",  "size": "0.5rem" },
                { "slug": "20", "name": "2 (16px)", "size": "1rem" },
                { "slug": "30", "name": "3 (24px)", "size": "1.5rem" },
                { "slug": "40", "name": "4 (32px)", "size": "2rem" },
                { "slug": "50", "name": "5 (48px)", "size": "3rem" },
                { "slug": "60", "name": "6 (64px)", "size": "4rem" },
                { "slug": "70", "name": "7 (96px)", "size": "6rem" },
                { "slug": "80", "name": "8 (128px)","size": "8rem" }
            ]
        },
        "border": { "color": true, "radius": true, "style": true, "width": true },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                { "slug": "subtle",   "name": "Subtle",   "shadow": "0 1px 2px 0 rgba(14, 31, 51, 0.05)" },
                { "slug": "soft",     "name": "Soft",     "shadow": "0 4px 12px -2px rgba(14, 31, 51, 0.08), 0 2px 4px -1px rgba(14, 31, 51, 0.04)" },
                { "slug": "elevated", "name": "Elevated", "shadow": "0 12px 32px -8px rgba(14, 31, 51, 0.12), 0 4px 12px -4px rgba(14, 31, 51, 0.06)" },
                { "slug": "lifted",   "name": "Lifted",   "shadow": "0 24px 48px -12px rgba(14, 31, 51, 0.16)" }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--white)",
            "text": "var(--wp--preset--color--navy)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "fontWeight": "400",
            "lineHeight": "1.65",
            "letterSpacing": "-0.005em"
        },
        "spacing": {
            "padding": {
                "top": "0",
                "right": "var(--wp--preset--spacing--40)",
                "bottom": "0",
                "left": "var(--wp--preset--spacing--40)"
            },
            "blockGap": "var(--wp--preset--spacing--40)"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--display)",
                    "fontWeight": "700",
                    "lineHeight": "1.05",
                    "letterSpacing": "-0.03em"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "700",
                    "lineHeight": "1.1",
                    "letterSpacing": "-0.02em"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "600",
                    "lineHeight": "1.2",
                    "letterSpacing": "-0.015em"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600",
                    "lineHeight": "1.3"
                }
            },
            "link": {
                "color": { "text": "var(--wp--preset--color--navy)" },
                "typography": { "textDecoration": "underline" },
                ":hover":  { "color": { "text": "var(--wp--preset--color--yellow)" }, "typography": { "textDecoration": "underline" } },
                ":focus":  { "color": { "text": "var(--wp--preset--color--yellow)" } }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--navy)",
                    "text": "var(--wp--preset--color--white)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "600",
                    "letterSpacing": "0.01em"
                },
                "border": { "radius": "999px" },
                "spacing": {
                    "padding": { "top": "0.75rem", "right": "1.5rem", "bottom": "0.75rem", "left": "1.5rem" }
                },
                "shadow": "var(--wp--preset--shadow--soft)",
                ":hover": {
                    "color": { "background": "var(--wp--preset--color--yellow)", "text": "var(--wp--preset--color--navy)" },
                    "shadow": "var(--wp--preset--shadow--elevated)"
                },
                ":focus": {
                    "color": { "background": "var(--wp--preset--color--yellow)", "text": "var(--wp--preset--color--navy)" }
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em"
                },
                "elements": {
                    "link": { "typography": { "textDecoration": "none" } }
                }
            },
            "core/post-title": {
                "typography": { "fontWeight": "700" }
            },
            "core/navigation": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "500",
                    "letterSpacing": "0"
                },
                "elements": {
                    "link": {
                        "typography": { "textDecoration": "none" },
                        ":hover": { "color": { "text": "var(--wp--preset--color--yellow)" } }
                    }
                }
            },
            "core/separator": {
                "color": { "background": "var(--wp--preset--color--slate-soft)" }
            }
        }
    },
    "customTemplates": [
        { "name": "front-page", "title": "Page d'accueil", "postTypes": ["page"] }
    ]
}
